# ============================================================
# Vaanii — environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# NEVER commit real values. Anything starting with NEXT_PUBLIC_ is
# exposed to the browser — keep secrets un-prefixed.
# ============================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://vaanii.in

# The developer's portal. After a paid, logged-in user clicks
# "Open dashboard", they are redirected here with a signed token.
# Use https:// in production. A bare http:// IP works for testing only.
NEXT_PUBLIC_PORTAL_URL=

# ---- Supabase (auth + database; source of truth for accounts) ----
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, full DB access. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (subscriptions) ----
# From Razorpay dashboard → Settings → API Keys. Use test keys for dev.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Settings → Webhooks → the secret you set there
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Plan IDs — create one plan per tier per interval in the
# Razorpay dashboard (Subscriptions → Plans) and paste the plan_xxx IDs.
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_YEARLY=
RAZORPAY_PLAN_GROWTH_MONTHLY=
RAZORPAY_PLAN_GROWTH_YEARLY=
RAZORPAY_PLAN_SCALE_MONTHLY=
RAZORPAY_PLAN_SCALE_YEARLY=

# ---- Portal handoff (SSO) ----
# Strong random string shared privately with the portal developer.
# Generate: openssl rand -hex 32
PORTAL_HANDOFF_SECRET=
# API key the portal sends when calling GET /api/entitlements.
# Generate: openssl rand -hex 24
ENTITLEMENTS_API_KEY=
